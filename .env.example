# Base de datos (contenedor sotra-db). Completar usuario, contraseña y nombre con valores a eleccion.
# DB_HOST y DB_PORT son para conectarse desde la maquina (pgAdmin, dotnet run, restaurar-base.sh);
# dentro de Docker el backend y Keycloak usan db:5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sotra
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# API
API_PORT=8081
ASPNETCORE_ENVIRONMENT=Production
FRONTEND_ORIGIN=http://localhost
# true: los endpoints exigen un token de Keycloak con el rol correspondiente (producción).
# false: no exigen token, para usar el frontend mientras todavía no integra el login.
AUTH_OBLIGATORIA=true
# Direcciones o redes CIDR (separadas por coma) de los proxies que reenvian X-Forwarded-For, por ejemplo Nginx.
# Sin este valor la API limita por la direccion del proxy en lugar de la de cada persona.
PROXIES_CONFIANZA=

# IA: los embeddings (bge-m3) y el reranker corren dentro de la API con ONNX. En Docker no hay que configurar
# nada: el servicio modelos-ia de compose.yml los descarga al volumen sotra_modelos_reranker y el backend los
# monta en /modelos. Estas rutas son solo para dotnet run fuera de Docker, apuntando a una copia local.
RERANKER_MODELO_RUTA=/modelos/model_quantized.onnx
RERANKER_TOKENIZADOR_RUTA=/modelos/tokenizer.json
EMBEDDINGS_MODELO_RUTA=/modelos/embeddings/model_quantized.onnx
EMBEDDINGS_TOKENIZADOR_RUTA=/modelos/embeddings/tokenizer.json

# IA: el resumen de las sugerencias lo redacta un proveedor externo con API compatible con OpenAI.
# Por defecto Groq (https://api.groq.com/openai/v1/) con openai/gpt-oss-20b; URL y modelo vacios usan esos valores.
# La clave se crea en console.groq.com y nunca se sube al repositorio. Sin clave, o con el proveedor caido,
# la API muestra el texto del manual sin resumir y avisa al usuario.
# IA_API_ESFUERZO se manda como reasoning_effort; dejarlo vacio para proveedores que no lo aceptan.
IA_API_URL=
IA_API_MODELO=
IA_API_ESFUERZO=low
# Llamadas por minuto al proveedor para toda la API; las que se pasan usan el texto del manual con aviso.
IA_API_LLAMADAS_POR_MINUTO=10
# La clave va sin valor: cada entorno la pone en su .env.
IA_API_CLAVE=

# Keycloak (completar las contraseñas con valores a eleccion)
KC_PORT=9080
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=tu_password_keycloak_db
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=tu_password_admin_keycloak

# Validacion de tokens en la API al correrla fuera de Docker (dotnet run).
# Dentro de Docker, compose.yml las define y KEYCLOAK_METADATA usa la red interna (keycloak:8080).
KEYCLOAK_EMISOR=http://localhost:9080/realms/sotra
KEYCLOAK_METADATA=http://localhost:9080/realms/sotra/.well-known/openid-configuration
KEYCLOAK_AUDIENCIA=sotra-api

# Gestion de usuarios en Keycloak desde la API (alta, modificacion, baja y restablecer contraseña).
# El secreto se copia de la consola: realm sotra > Clients > sotra-backend-admin > Credentials.
# KEYCLOAK_ADMIN_URL, KEYCLOAK_REALM, KEYCLOAK_ADMIN_CLIENTE y KEYCLOAK_CLIENTE_FRONTEND son
# para dotnet run; dentro de Docker los define compose.yml.
KEYCLOAK_ADMIN_SECRETO=secreto_de_sotra-backend-admin
KEYCLOAK_ADMIN_URL=http://localhost:9080
KEYCLOAK_REALM=sotra
KEYCLOAK_ADMIN_CLIENTE=sotra-backend-admin
KEYCLOAK_CLIENTE_FRONTEND=sotra-frontend

# Correo de Keycloak por Gmail (KC_SMTP_PASSWORD es una contraseña de aplicación de Google)
KC_SMTP_HOST=smtp.gmail.com
KC_SMTP_PORT=587
KC_SMTP_FROM=tu_cuenta@gmail.com
KC_SMTP_USER=tu_cuenta@gmail.com
KC_SMTP_PASSWORD=tu_password_de_aplicacion

# Observabilidad (OpenTelemetry). Apagada mientras no haya destino.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=sotra-api

# Opcional: umbrales de las alertas de maquinaria (horas) y días de reincidencia. Valores por defecto entre paréntesis.
# AlertasMaquinaria__SinAsignarHoras=24
# AlertasMaquinaria__AsignadaSinIniciarHoras=48
# AlertasMaquinaria__PausadaHoras=72
# AlertasMaquinaria__MaquinaDetenidaAltaHoras=48
# AlertasMaquinaria__MaquinaDetenidaMediaHoras=120
# AlertasMaquinaria__MaquinaDetenidaBajaHoras=240
# AlertasMaquinaria__ReincidenciaDias=90
